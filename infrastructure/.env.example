# Database
# Option 1: Local PostgreSQL (for development)
DATABASE_URL=postgresql://agent_user:agent_pass@db:5432/agent_mvp

# Option 2: Supabase (for production, requires VPN bypass or non-corporate network)
# DATABASE_URL=postgresql://postgres.your-project-ref:your-password@aws-0-region.pooler.supabase.com:6543/postgres?sslmode=require

# Ollama (required)
# Use http://ollama:11434 for local docker-compose setup
# Use http://your-gpu-vm:11434 for remote GPU VM
OLLAMA_URL=http://ollama:11434

# MCP (optional for Ticket 1)
MCP_SERVER_URL=http://your-mcp-server:8080

# Backend (required)
BACKEND_PORT=8000
SECRET_KEY=change-this-in-production
BACKEND_ENV=development

# Gateway MCP (required for MCP tools)
# Service token for backend->gateway authentication
GATEWAY_SERVICE_TOKEN=change-this-in-production
# Fernet key for credential encryption (generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
GATEWAY_CREDENTIAL_ENCRYPTION_KEY=
# Gateway URL (defaults to http://localhost:8090 if not set)
MCP_GATEWAY_URL=http://localhost:8090

# Atlassian OAuth (for Jira integration)
# Get these from: https://developer.atlassian.com/console/myapps/
ATLASSIAN_CLIENT_ID=
ATLASSIAN_CLIENT_SECRET=
# Set this to your ngrok or public URL for OAuth callbacks
ATLASSIAN_REDIRECT_URI=http://localhost:8000/api/credentials/atlassian/callback

# BRS Teesheet API (for golf club management)
# These credentials are obtained from BRS:
# 1. Create a club via console
# 2. Create a superuser for that club
# 3. Get the api_key from fe_users table for that superuser
# 4. Contact BRS for client_id and client_secret
BRS_TEESHEET_URL=https://api.brs.dev
BRS_CLIENT_ID=
BRS_CLIENT_SECRET=
BRS_API_KEY=
# Grant type for OAuth exchange (usually "api_key")
BRS_GRANT_TYPE=api_key

# Open WebUI
WEBUI_PORT=3000

# DeepEval
DEEPEVAL_API_KEY=your-deepeval-api-key

# DeepEval judge model (Gemini — avoids OpenAI dependency for test scoring)
USE_GEMINI_MODEL=true
GEMINI_MODEL_NAME=gemini-2.0-flash

# Google API Key (used by DeepEval's GeminiModel judge)
GOOGLE_API_KEY=your-google-api-key
