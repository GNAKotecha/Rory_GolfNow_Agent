# ===== Backend runtime (Runpod) =====
BACKEND_ENV=development
BACKEND_PORT=8000

# Local DB 
# DATABASE_URL=postgresql://agent_user:agent_pass@localhost:5432/agent_mvp

# Supabase DB
DATABASE_URL=postgresql://postgres.szahfwvdvjmrvqfkkfni:[password]@aws-1-eu-central-1.pooler.supabase.com:6543/postgres

SECRET_KEY=
OLLAMA_URL=http://localhost:11434

# Gateway routing (backend -> gateway)
MCP_GATEWAY_URL=
GATEWAY_SERVICE_TOKEN=

# Keep MCP discovery clean on Runpod
ENABLE_AUX_MCP_SERVERS=false
ENABLE_BASH_TOOL=false


START_GATEWAY_LOCAL=false
STRICT_TOOL_FAILURE_TERMINAL=true

# Optional observability
LANGFUSE_ENABLED=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=

# ===== Gateway MCP runtime =====

GATEWAY_ENV=local
GATEWAY_HOST=0.0.0.0
GATEWAY_PORT=8090

# MCP
GATEWAY_SERVICE_TOKEN=
GATEWAY_CREDENTIAL_ENCRYPTION_KEY=

# Atlassian
ATLASSIAN_CLIENT_ID=
ATLASSIAN_CLIENT_SECRET=
ATLASSIAN_REDIRECT_URI=

# BRS
BRS_TEESHEET_URL=http://localhost:8056
BRS_CLIENT_ID=
BRS_CLIENT_SECRET=
BRS_GRANT_TYPE=http://www.brsgolf.com/grants/api_key

# ===== Optional for testing =====

# DeepEval
DEEPEVAL_API_KEY=deep_eval_api_key

# GEMINI for LLM Judge
USE_GEMINI_MODEL=true
GEMINI_MODEL_NAME=gemini-2.0-flash
GEMINI_API_KEY=gemini_api_key
