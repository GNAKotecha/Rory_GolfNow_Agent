# Database Configuration
# SQLite (local development)
DATABASE_URL=sqlite:///./data/agent.db

# PostgreSQL (production)
# DATABASE_URL=postgresql://user:password@hostname:5432/dbname

# Ollama Configuration
# Local Ollama instance
OLLAMA_URL=http://localhost:11434

# Remote Ollama instance
# OLLAMA_URL=http://ollama-host:11434

# Security
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=your-secret-key-here-change-in-production

# Optional: MCP Server URL (if using Model Context Protocol)
MCP_SERVER_URL=

# Optional: MCP Gateway URL (preferred over MCP_SERVER_URL)
MCP_GATEWAY_URL=http://localhost:8090

# Optional: Enable auxiliary MCP servers (test-mcp, mock-search)
# Set to true only if these servers are running locally
ENABLE_AUX_MCP_SERVERS=false

# Optional: Enable bash escape-hatch tool (requires worker service reachable at worker:8001)
# Keep false in Runpod-native setups unless worker is deployed separately.
ENABLE_BASH_TOOL=false

# Backend Configuration (usually don't need to change)
BACKEND_PORT=8000

# Langfuse Configuration
LANGFUSE_ENABLED=true
LANGFUSE_PUBLIC_KEY=pk-lf-local-dev
LANGFUSE_SECRET_KEY=sk-lf-local-dev
LANGFUSE_HOST=http://localhost:3000

# Langfuse Docker Compose Secrets
LANGFUSE_POSTGRES_PASSWORD=langfuse_dev
LANGFUSE_NEXTAUTH_SECRET=changeme_secret_key_min_32_chars_long
LANGFUSE_SALT=changeme_salt_min_32_chars_long

# BRS repository paths
BRS_TEESHEET_PATH=/path/to/brs-teesheet
BRS_CONFIG_PATH=/path/to/brs-config-api
BRS_TOOL_TIMEOUT_MULTIPLIER=1.0

# DeepEval Configuration
# Used by workflow correctness / hallucination / toxicity tests in tests/deepeval/
DEEPEVAL_API_KEY=your_api_key_here
